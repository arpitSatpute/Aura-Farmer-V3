# ============================================
# AI API CONFIGURATION
# ============================================

# AI service endpoint for optimal allocation calculations
AI_API_URL=https://ethmoney-aiservice.onrender.com/reallocate

# Optional: API key if your AI service requires authentication
AI_API_KEY=

# ============================================
# MONGODB CONFIGURATION
# ============================================

# MongoDB connection string
# Local: mongodb://localhost:27017/aura-farmer
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/aura-farmer
MONGODB_URI=mongodb://localhost:27017/aura-farmer

# Database name
MONGODB_DB_NAME=aura-farmer

# ============================================
# AUTOMATION INTERVALS
# ============================================

# Rebalance interval (milliseconds)
# Default: 600000 (10 minutes)
# For testing: 300000 (5 minutes)
REBALANCE_INTERVAL=600000

# Harvest interval (milliseconds)
# Default: 3600000 (1 hour)
# For testing: 600000 (10 minutes)
HARVEST_INTERVAL=3600000

# Data refresh interval for APY updates (milliseconds)
DATA_REFRESH_INTERVAL=20000




# Clearnode WebSocket URL
NITROLITE_CLEARNODE=wss://clearnet.yellow.com/ws

# Batch settlement interval (milliseconds)
# Default: 300000 (5 minutes)
SETTLEMENT_INTERVAL=300000


# Number of days of historical APY data to fetch for AI analysis
APY_HISTORY_DAYS=7

# GAS CONFIGURATION

MAX_GAS_PRICE=100

GAS_LIMIT_REBALANCE=3000000
GAS_LIMIT_HARVEST=500000
LOG_LEVEL=info
ENABLE_DRY_RUN=false

# Require manual confirmation before transactions
REQUIRE_CONFIRMATION=false

# ============================================
# MONITORING
# ============================================

# Enable health check endpoint
ENABLE_HEALTH_CHECK=true

# Health check server port
HEALTH_CHECK_PORT=3000
